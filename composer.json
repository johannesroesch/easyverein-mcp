{
    "name": "easyverein/mcp-server",
    "description": "MCP server exposing the EasyVerein API v3.0 as MCP tools",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "EasyVerein\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasyVerein\\Mcp\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "php-mock/php-mock-phpunit": "^2.9",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "scripts": {
        "test": "phpunit",
        "test-unit": "phpunit --testsuite Unit",
        "test-integration": "phpunit --testsuite Integration",
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer check --allow-risky=yes",
        "cs-fix": "php-cs-fixer fix --allow-risky=yes"
    }
}
